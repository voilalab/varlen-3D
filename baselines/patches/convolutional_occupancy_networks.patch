diff --git a/scripts/download_data.sh b/scripts/download_data.sh
index d38a77f..0fc4827 100644
--- a/scripts/download_data.sh
+++ b/scripts/download_data.sh
@@ -1,7 +1,33 @@
 #!/bin/bash
+# Download and extract ShapeNet data
+# Usage: ./download_data.sh [category]
+# Example: ./download_data.sh 03001627  (for chairs only)
+# If no category specified, extracts all data
+
+CATEGORY=${1:-""}
+
 mkdir -p data
 cd data
-echo "Start downloading ..."
-wget https://s3.eu-central-1.amazonaws.com/avg-projects/convolutional_occupancy_networks/data/synthetic_room_dataset.zip
-unzip synthetic_room_dataset.zip
-echo "Done!"
\ No newline at end of file
+
+# Download if not already present
+if [ ! -f "dataset_small_v1.1.zip" ]; then
+    echo "Downloading dataset..."
+    wget https://s3.eu-central-1.amazonaws.com/avg-projects/occupancy_networks/data/dataset_small_v1.1.zip
+fi
+
+# Extract data
+if [ -n "$CATEGORY" ]; then
+    echo "Extracting only category: $CATEGORY"
+    # Extract only the specified category + metadata
+    unzip -o dataset_small_v1.1.zip "ShapeNet/$CATEGORY/*" "metadata.yaml"
+else
+    echo "Extracting all categories..."
+    unzip -o dataset_small_v1.1.zip
+fi
+
+# Copy metadata if needed
+if [ ! -f "ShapeNet/metadata.yaml" ] && [ -f "metadata.yaml" ]; then
+    cp metadata.yaml ShapeNet/metadata.yaml
+fi
+
+echo "Done! Data extracted to data/ShapeNet/"
\ No newline at end of file
