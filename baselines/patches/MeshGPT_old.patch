+def _triangle_tensor_chamfer(pred_coords: torch.Tensor, gt_coords: torch.Tensor, num_samples: int = 2048) -> torch.Tensor:
+    """Chamfer distance between separated-triangle tensors (F, 9). Samples ``num_samples`` points per
+    mesh surface, then bidirectional Chamfer via pytorch3d. Returns NaN scalar on failure."""
+    try:
+        pred_vertices = pred_coords.reshape(-1, 3)
+        gt_vertices = gt_coords.reshape(-1, 3)
+        pred_num_faces = pred_coords.shape[0]
+        gt_num_faces = gt_coords.shape[0]
+        pred_faces = torch.arange(pred_num_faces * 3, dtype=torch.long, device=pred_coords.device).reshape(pred_num_faces, 3)
+        gt_faces = torch.arange(gt_num_faces * 3, dtype=torch.long, device=gt_coords.device).reshape(gt_num_faces, 3)
+        pred_mesh = Meshes(verts=[pred_vertices], faces=[pred_faces])
+        gt_mesh = Meshes(verts=[gt_vertices], faces=[gt_faces])
+        pred_points = sample_points_from_meshes(pred_mesh, num_samples=num_samples)
+        gt_points = sample_points_from_meshes(gt_mesh, num_samples=num_samples)
+        cd, _ = chamfer_distance(pred_points, gt_points)
+        return cd
+    except Exception:
+        return torch.tensor(float('nan'), device=pred_coords.device)
+
