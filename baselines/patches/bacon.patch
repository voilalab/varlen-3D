+def count_params_per_level(model):
+    """Count cumulative learnable parameters needed to evaluate each output level.
+
+    With reuse_filters=True and hidden_layers=8, the filter reuse mapping is:
+        filter_ind_dict = [2, 2, 2, 4, 4, 6, 6, 8, 8]
+    FourierLayer weights are frozen; only biases are learnable.
+    """
+    filter_ind_dict = [2, 2, 2, 4, 4, 6, 6, 8, 8]
+    results = {}
+
+    for level in model.output_layers:
+        total = 0
+
+        used_filters = set(filter_ind_dict[:level + 1])
+        for f_idx in used_filters:
+            total += model.filters[f_idx].linear.bias.numel()
+
+        for i in range(level):
+            total += sum(p.numel() for p in model.linear[i].parameters())
+
+        total += sum(p.numel() for p in model.output_linear[level].parameters())
+
+        results[level] = total
+
+    return results
+
+
+def count_data_params(point_cloud_path):
+    """Count data parameters from an .xyz point cloud file: num_points * 3."""
+    with open(point_cloud_path, 'r') as f:
+        num_points = sum(1 for line in f if line.strip())
+    return num_points * 3
+
