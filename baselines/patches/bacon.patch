     def __getitem__(self, idx):
         coords, sdf = self.sample_surface()
 
+        n_uniform = self.num_samples // 4
+        uniform_pts = np.random.uniform(-0.5, 0.5, (n_uniform, 3)).astype(np.float32)
+        uniform_dist, uniform_idx = self.kd_tree.query(uniform_pts, k=1)
+        uniform_sdf = uniform_dist[..., None].astype(np.float32)
+
+        coords = np.concatenate([coords, uniform_pts], axis=0)
+        sdf = np.concatenate([sdf, uniform_sdf], axis=0)
+
         return {'coords': torch.from_numpy(coords).float()}, \
                {'sdf': torch.from_numpy(sdf).float()}
